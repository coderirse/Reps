<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 联网只用于两件只读的事：拉取云端题库（列表 + CSV）与检查应用更新。
         Reps 不上传任何用户数据——题库、进度、错题、笔记全部只存本机；
         本地备份仍是应用内 JSON 导出/导入（allowBackup 保持 false）。
         这条边界由 app/build.gradle.kts 的 verifyNetworkContainment 门禁强制：
         网络调用只允许出现在 data/net 包内。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 应用内更新的安装环节需要：不声明它时 canRequestPackageInstalls() 恒为
         false，且「安装未知应用」设置页里不会出现本应用的开关，安装流程会被
         卡死在权限循环里。Reps 是自分发（GitHub + 自建服务器），不涉及商店政策。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".RepsApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reps">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Reps"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 更新包（APK）与云端题库（CSV）的缓存文件要交给系统安装器 / 应用内导入读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>